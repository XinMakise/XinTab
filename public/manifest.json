{
  "manifest_version": 3,
  "name": "XinTab",
  "version": "0.3.0",
  "description": "一个自然简洁的新标签页：手动导航 + 自动书签分类。",
  "permissions": ["bookmarks", "storage", "history"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
